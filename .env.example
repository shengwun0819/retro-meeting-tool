# Supabase (required)
# Get these from: https://supabase.com/dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Base URL (required for SSR API calls)
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ClickUp Integration
# Two paths exist:
#   1. Web-app direct API (Stage 1 — Personal Token, in development)
#   2. Claude Code MCP Server (existing, kept as fallback)
#
# For path 1, users supply their own ClickUp Personal Token in /settings; tokens
# are encrypted with the key below before being stored in user_settings.
# Generate a key with:  openssl rand -base64 32
# Must be ≥16 chars. Same key required across all environments that share the DB.
CLICKUP_TOKEN_ENCRYPTION_KEY=
